import pandas as pd


#Data transformation
#the process of converting raw data into a clean, organized, and standardized format
df=pd.read_csv("raw_data.csv")
df2=df.copy()


#apply --- Applies a function to every value (or row/column). --- works on series and dataframes both
#creating a new column - tax
#use apply function --- pass another function inside apply
#apply: higher order function , because it takes a function as a parameter

#What apply() CAN do
# Run custom functions
# Mathematical operations
# String operations
# Conditional logic

df2["tax"]=df2["income"].apply(lambda x: "20%" if x>=50000 else "10%")
df2


#map function --- Map one value to another
# works on series only
# it says: "Whenever you see X, replace it with Y."
# it can also apply functions

# Replace values using a dictionary
# Apply a function
# Work with one column
# can create new columns if you assign the result

#Cannot work on an entire DataFrame
#Cannot create a new column directly
gender_map={
    "Male":"M","Female":"F","Unknown":"U"
}
df2["gender"]=df2["gender"].map(gender_map)
#gender values will change from Male to M and ...


#assign function 
# Creates new columns or modifies existing columns (its main purpose)
# works on entire dataframe only- Cannot work on only one Series
df2.assign(new_income=df2["income"] * 1.1)


#replace(old , new) --- Replace specific existing values
# cannot create new columnsv--- can replace existing values only
#replacing USA with United states
df2["country"]=df2["country"].replace("USA","United States")



#rename
#renaming all columns --- making first letter capital
df2.columns=["Id","Name","Age","Country","Income","Tax","New_income"]

#changing individual column name--- income to salary
df2.rename(columns={"Income":"Salary"})

#rename row
df2.rename(index={1:"First"})





df2



