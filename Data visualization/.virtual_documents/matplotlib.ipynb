#Pie charts
# A pie chart is a circular chart divided into slices to show relative proportions of a whole.
# . Each slice = a category
# . Size of slice = value of that category relative to total

# Prefer them only for few categories. 5 or 6

expenses = ["Salaries", "Rent", "Marketing", "R&D", "Miscellaneous"]
amounts = [500, 150, 120, 100, 50]

explode=[0,0,0,.1,0]

plt.pie(amounts,labels=expenses,autopct="%1.1f%%",
        wedgeprops={
    "edgecolor":"black",
    "linewidth":1,
    "linestyle":"-",
    # "fill":False
    
},
        explode=explode,
        startangle=180,
        shadow=True
       )

plt.savefig("piechart.png")

plt.show()





#Histograms

# A histogram shows the distribution of numerical data by:
# · Dividing values into bins (ranges)
# . Counting how many values fall into each bin (frequency)

# use for numerical data, not for categorical data

import matplotlib.pyplot as plt
import numpy as np

np.random.seed(0)
scores=np.random.normal(70,10,1000) #normal distribution
bins=[30,50,70,90,100]
plt.hist(scores,color="skyblue",edgecolor="black",bins=bins)
plt.xlabel("Scores")
plt.ylabel("No. of Students")
plt.show()


marks = [
25, 38, 42, 55, 61, 67, 72, 78, 83, 88,
91, 95, 47, 53, 59, 64, 69, 74, 79, 85,
92, 97, 33, 45, 58, 62, 71, 76, 81, 89]

bins=[0,30,50,70,90,100]
#left value is inclusive and right value is exclusive in the bin
# 30 will be included in the bin 30-50 but 50 will not be included

plt.hist(marks,color="skyblue",edgecolor="black",bins=bins)

plt.axvline(
    x=33,
    label="passing marks (33)",
    color="red",
    linewidth="2",
    linestyle="-"
)

plt.xlabel("Marks")
plt.ylabel("No. of Students")
plt.title("Distribution of marks for students")

plt.legend(loc="upper left")
plt.show()


