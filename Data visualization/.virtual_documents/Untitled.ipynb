#Question 3
tips=sns.load_dataset("tips")
sns.boxplot(
    data=tips,
    x="total_bill",
    y="day",
    hue="sex"
)
plt.title("Total Bill Distribution by Day and Gender")
plt.xlabel("Day of the Week")
plt.ylabel("Total Bill ($)")


#Question 4
sns.scatterplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="sex",
    style="smoker",
    s=100
)
plt.title("Total bill vs Tips")
plt.xlabel("Total Bill")
plt.ylabel("Tip")

plt.legend()



