#bar charts
# A bar plot (or bar chart) is a graph that displays categorical data using rectangular bars.
# Each bar's height (or length, in horizontal bars) represents a value.


movies=[
    "The Dark knight",
    "The Heart locker",
    "The king's Speech",
    "The Artist",
    "Argo"
]
years=[2008,2009,2010,2011,2012]
revenue=[1005,170,427,133,232] #in $M

plt.style.use("default")

plt.bar(years,revenue,color="green")
plt.title("Revenue in each year for Oscar Movies")
plt.xlabel("Year")
plt.ylabel("Revenue in $M")

#plt.text to show value on each bar
#plt.text(x-axis pos, y-axis pos, text, alignment)

for i in range(len(years)):
    plt.text(years[i],oscar_revenue[i]+20,str(oscar_revenue[i]),ha="center")

# to increase x or y limits
plt.ylim(0,max(revenue)+100)

plt.show()


import numpy as np

# Bar chart: compare two sets of data
oscar_movies=[
    "The Dark knight",
    "The Heart locker",
    "The king's Speech",
    "The Artist",
    "Argo"
]
oscar_revenue=[1005,170,427,133,232] #in $M

non_oscar_movies=["Slumdog Millionaire","Avatar","Inception","Hugo","Lincoln"]
non_oscar_revenue=[378,2788,829,185,275] #in $M

years=[2008,2009,2010,2011,2012]

x=np.arange(len(years))
width=0.4

# x-width/2=x-0.2
# x+width/2=x+0.2

plt.bar(x-width/2,oscar_revenue,width,label="Oscar Movies") #shifting to left
plt.bar(x+width/2,non_oscar_revenue,width,label="Non Oscar Movies") #shifting to right
plt.title("Oscar vs Non oscar Movies Revenue")
plt.xlabel("Year")
plt.ylabel("Revenue in $M")

plt.legend()

#replace x values(1,2,3..) with year values now
plt.xticks(x,years)

plt.show()


