import numpy as np



#execution performance comparison of np arrays and python lists
import time

size=10_000_000

#python list
py_list=list(range(size))
start=time.time()
sq_list=[x**2 for x in py_list]
end=time.time()
print(f"Python list time={end-start} seconds")

#numpy array
np_arr=np.array(py_list)
start=time.time()
#vectorization
sq_arr=np_arr ** 2
end=time.time()
print(f"numpy array time={end-start} seconds")





